[TEMPLATE]

APP_NAME=AIPT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Timezone is hardcoded to Asia/Kolkata in config/app.php (not env-driven)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug

# Database
# Default driver is mariadb (see config/module-database.php). The app is built for MariaDB/MySQL.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Cache (database-driven by default; CACHE_TTL is used by the Cacheable trait in repositories)
CACHE_STORE=database
CACHE_TTL=3600

# Queue & Session (database-driven by default)
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Cookie domain for the JWT `token` cookie (e.g. .aipt-api.local for subdomains).
# AuthController reads config('session.domain') when setting the cookie.
SESSION_DOMAIN=
# Session cookie only — the JWT `token` cookie always sets secure=true in AuthController
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# JWT (php-open-source-saver/jwt-auth)
# REQUIRED: run `php artisan jwt:secret` to generate JWT_SECRET
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0

# Broadcasting — Laravel Reverb
# Generate credentials with `php artisan reverb:install` (adds REVERB_APP_ID/KEY/SECRET)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=

# Filesystem
FILESYSTEM_DISK=local

# Mail (log driver by default; swap to smtp for real sending)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Social auth (Laravel Socialite) — OAuth2 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Sanctum — stateful frontend origins (comma separated)
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173
